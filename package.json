{
  "name": "novelevolver",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"bun run dev:renderer\" \"bun run dev:electron\" \"bun run dev:start\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/build-electron.mjs --watch",
    "dev:start": "wait-on tcp:5173 dist-electron/main.js && electron .",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "lint": "oxlint src electron shared",
    "lint:fix": "oxlint --fix src electron shared",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@codehz/auto-transition": "^0.0.7-14",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@iconify/json": "^2.2.493",
    "@iconify/utils": "^3.1.3",
    "@mogeko/maple-mono-cn": "^7.9.0",
    "bunshi": "^2.2.0",
    "capnweb": "^0.8.0",
    "clsx": "^2.1.1",
    "electron": "^42.5.1",
    "foxact": "^0.3.8",
    "jotai": "^2.20.1",
    "misans": "^4.1.0",
    "motion": "^12.42.0",
    "nano-git": "^0.7.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "slot-text": "^0.3.1",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tailwindcss": "^1.3.3",
    "oxlint-tsgolint": "^0.23.0",
    "tailwindcss": "^4.3.2",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  },
  "lint-staged": {
    "*": "oxfmt --write --no-error-on-unmatched-pattern"
  }
}
