{
  "name": "novelevolver",
  "version": "0.3.4",
  "private": true,
  "description": "NovelEvolver monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @novelevolver/desktop dev",
    "mobile": "bun run --filter @novelevolver/mobile start",
    "mobile:android": "bun run --filter @novelevolver/mobile android",
    "mobile:ios": "bun run --filter @novelevolver/mobile ios",
    "build": "bun run --filter @novelevolver/desktop build",
    "pack": "bun run --filter @novelevolver/desktop pack",
    "dist": "bun run --filter @novelevolver/desktop dist",
    "dist:linux": "bun run --filter @novelevolver/desktop dist:linux",
    "dist:win": "bun run --filter @novelevolver/desktop dist:win",
    "dist:mac": "bun run --filter @novelevolver/desktop dist:mac",
    "lint": "oxlint apps/desktop/src apps/desktop/electron packages/domain packages/desktop-rpc apps/mobile/src apps/mobile/index.js apps/mobile/rollipop.config.ts && echo LINT DONE",
    "lint:fix": "oxlint --fix apps/desktop/src apps/desktop/electron packages/domain packages/desktop-rpc apps/mobile/src apps/mobile/index.js apps/mobile/rollipop.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "fonts:ensure": "node scripts/ensure-fonts.mjs",
    "prepare": "node scripts/ensure-fonts.mjs && husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tailwindcss": "^1.3.5",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "wawoff2": "^2.0.1"
  },
  "optionalDependencies": {
    "@oxlint/binding-darwin-arm64": "1.75.0",
    "@oxlint/binding-darwin-x64": "1.75.0",
    "@oxlint/binding-linux-x64-gnu": "1.75.0",
    "@oxlint/binding-linux-x64-musl": "1.75.0",
    "@oxlint/binding-win32-x64-msvc": "1.75.0"
  },
  "lint-staged": {
    "*": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "patchedDependencies": {
    "react-native@0.87.1": "patches/react-native@0.87.1.patch"
  }
}
