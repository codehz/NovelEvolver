{
  "name": "novelevolver",
  "version": "0.2.0",
  "private": true,
  "description": "NovelEvolver desktop app",
  "author": "codehz",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "NOVEL_EVOLVER_MOCK_AI=1 concurrently -k \"bun run dev:renderer\" \"bun run dev:electron\" \"bun run dev:start\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/build-electron.mjs --watch",
    "dev:start": "wait-on tcp:5173 dist-electron/main.js && electron .",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder --publish never",
    "dist:linux": "bun run build && electron-builder --linux AppImage --publish never",
    "dist:win": "bun run build && electron-builder --win nsis portable --publish never",
    "dist:mac": "bun run build && electron-builder --mac dmg --publish never",
    "lint": "oxlint src electron shared && echo LINT DONE",
    "lint:fix": "oxlint --fix src electron shared",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "fonts:ensure": "node scripts/ensure-fonts.mjs",
    "prepare": "node scripts/ensure-fonts.mjs && husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@catppuccin/tailwindcss": "^1.0.0",
    "@codehz/ai": "^0.4.6",
    "@codehz/auto-transition": "^0.0.8-3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@iconify/json": "^2.2.504",
    "@iconify/utils": "^3.1.4",
    "@streamdown/cjk": "^1.0.3",
    "bunshi": "^2.2.0",
    "capnweb": "npm:@codehz/capnweb@0.10.0",
    "clsx": "^2.1.1",
    "foxact": "^0.3.8",
    "jotai": "^2.20.2",
    "motion": "^12.42.2",
    "nano-git": "^0.10.2",
    "nanoid": "^6.0.0",
    "partial-json": "^0.1.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "slot-text": "^0.3.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tailwindcss": "^1.3.5",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0",
    "wawoff2": "^2.0.1"
  },
  "resolutions": {
    "@codemirror/commands": "$@codemirror/commands",
    "@codemirror/lang-markdown": "$@codemirror/lang-markdown",
    "@codemirror/language": "$@codemirror/language",
    "@codemirror/merge": "$@codemirror/merge",
    "@codemirror/search": "$@codemirror/search",
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view"
  },
  "lint-staged": {
    "*": "oxfmt --write --no-error-on-unmatched-pattern"
  }
}
