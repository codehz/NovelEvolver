{
  "name": "novelevolver",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "NOVEL_EVOLVER_MOCK_AI=1 concurrently -k \"bun run dev:renderer\" \"bun run dev:electron\" \"bun run dev:start\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/build-electron.mjs --watch",
    "dev:start": "wait-on tcp:5173 dist-electron/main.js && electron .",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "lint": "oxlint src electron shared",
    "lint:fix": "oxlint --fix src electron shared",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "prepare": "husky"
  },
  "dependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@codehz/ai": "^0.2.1",
    "@codehz/auto-transition": "^0.0.7-14",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@iconify/json": "^2.2.496",
    "@iconify/utils": "^3.1.4",
    "@mogeko/maple-mono-cn": "^7.9.0",
    "@streamdown/cjk": "^1.0.3",
    "bunshi": "^2.2.0",
    "capnweb": "npm:@codehz/capnweb@0.10.0",
    "clsx": "^2.1.1",
    "electron": "^43.0.0",
    "foxact": "^0.3.8",
    "jotai": "^2.20.1",
    "misans": "^4.1.0",
    "motion": "^12.42.2",
    "nano-git": "^0.9.4",
    "nanoid": "^5.1.16",
    "partial-json": "^0.1.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "slot-text": "^0.3.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tailwindcss": "^1.3.4",
    "oxlint-tsgolint": "^0.24.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "wait-on": "^9.0.10"
  },
  "resolutions": {
    "@codemirror/commands": "$@codemirror/commands",
    "@codemirror/lang-markdown": "$@codemirror/lang-markdown",
    "@codemirror/language": "$@codemirror/language",
    "@codemirror/merge": "$@codemirror/merge",
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view"
  },
  "lint-staged": {
    "*": "oxfmt --write --no-error-on-unmatched-pattern"
  }
}
