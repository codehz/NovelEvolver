{
  "name": "novelevolver",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"bun run dev:renderer\" \"bun run dev:electron\" \"bun run dev:start\"",
    "dev:renderer": "vite",
    "dev:electron": "tsdown --config tsdown.electron.mts --watch",
    "dev:start": "wait-on tcp:5173 dist-electron/main.js && electron .",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsdown --config tsdown.electron.mts",
    "lint": "oxlint src electron shared",
    "lint:fix": "oxlint --fix src electron shared",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@iconify/json": "^2.2.492",
    "@iconify/utils": "^3.1.3",
    "clsx": "^2.1.1",
    "electron": "^42.5.0",
    "foxact": "^0.3.8",
    "nano-git": "^0.7.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tailwindcss": "^1.3.3",
    "oxlint-tsgolint": "^0.23.0",
    "tailwindcss": "^4.3.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  }
}
