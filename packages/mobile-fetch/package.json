    }
  },
  "scripts": {
    "specs": "nitrogen --logLevel=\"debug\""
  },
  "devDependencies": {
    "nitrogen": "^0.37.1",
    "react-native-nitro-modules": "^0.37.1"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-native": ">=0.87.0",
    "react-native-nitro-modules": "^0.37.1"
  }
}
