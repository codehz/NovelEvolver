{
  "name": "@novelevolver/mobile-fetch",
  "version": "0.0.0",
  "private": true,
  "description": "Streaming fetch Nitro Module for the NovelEvolver mobile app",
  "files": [
    "android",
    "ios",
    "nitrogen",
    "src",
    "nitro.json",
    "NovelEvolverMobileFetch.podspec",
    "react-native.config.cjs"
  ],
  "type": "module",
