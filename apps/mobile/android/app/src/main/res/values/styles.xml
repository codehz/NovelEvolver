<resources>

    <!-- Locked to Mocha (not DayNight) — same as desktop color-scheme: dark. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/app_foreground</item>
        <item name="android:textColorPrimary">@color/app_foreground</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorAccent">@color/app_primary</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

</resources>
