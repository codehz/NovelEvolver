{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "node", "bun"],
    "paths": {
      "#app/*": ["./src/*"],
      "#domain/ai": ["../../packages/domain/ai/index.ts"],
      "#domain/worktree": ["../../packages/domain/worktree/index.ts"],
      "#domain/*": ["../../packages/domain/*"],
      "@novelevolver/domain/worktree": ["../../packages/domain/worktree/index.ts"],
      "@novelevolver/domain/*": ["../../packages/domain/*"],
      "@novelevolver/worktree": ["../../packages/worktree/src/index.ts"],
      "#desktop-rpc/*": ["../../packages/desktop-rpc/*"],
      "#workbench/*": ["./src/features/project-workbench/*"]
    }
  },
  "include": ["src", "electron", "path-aliases.ts", "vite.config.ts"]
}
