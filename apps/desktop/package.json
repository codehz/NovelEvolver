{
  "name": "@novelevolver/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "NovelEvolver desktop app (Electron)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "NOVEL_EVOLVER_MOCK_AI=1 concurrently -k \"bun run dev:renderer\" \"bun run dev:electron\" \"bun run dev:start\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/build-electron.mjs --watch",
    "dev:start": "wait-on tcp:5173 dist-electron/main.js && electron .",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder --publish never",
    "dist:linux": "bun run build && electron-builder --linux AppImage --publish never",
    "dist:win": "bun run build && electron-builder --win nsis portable --publish never",
    "dist:mac": "bun run build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@catppuccin/tailwindcss": "^1.0.0",
    "@codehz/ai": "0.9.1",
    "@codehz/auto-transition": "^0.0.10",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@iconify/json": "^2.2.526",
    "@iconify/utils": "^3.1.7",
    "@lezer/highlight": "^1.2.3",
    "@novelevolver/ai-runtime": "workspace:*",
    "@novelevolver/desktop-rpc": "workspace:*",
    "@novelevolver/domain": "workspace:*",
    "@novelevolver/worktree": "workspace:*",
    "@streamdown/cjk": "^1.0.3",
    "bunshi": "^2.2.0",
    "capnweb": "npm:@codehz/capnweb@0.10.0",
    "clsx": "^2.1.1",
    "foxact": "^0.3.11",
    "jotai": "^2.20.3",
    "motion": "^13.2.0",
    "nano-git": "^0.14.0",
    "nanoid": "^6.0.1",
    "partial-json": "^0.1.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.5",
    "slot-text": "^0.3.4",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "resolutions": {
    "@codemirror/commands": "$@codemirror/commands",
    "@codemirror/lang-markdown": "$@codemirror/lang-markdown",
    "@codemirror/language": "$@codemirror/language",
    "@codemirror/merge": "$@codemirror/merge",
    "@codemirror/search": "$@codemirror/search",
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view"
  },
  "productName": "NovelEvolver"
}
