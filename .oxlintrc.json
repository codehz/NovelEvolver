{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "apps/desktop/dist/**",
    "apps/desktop/dist-electron/**",
    "apps/mobile/android/**",
    "apps/mobile/ios/**",
    "apps/mobile/vendor/**",
    "apps/mobile/.rollipop/**",
    "packages/mobile-sqlite/nitrogen/**",
    "node_modules/**"
  ],
  "jsPlugins": ["oxlint-tailwindcss"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "apps/desktop/src/index.css"
    }
  },
  "rules": {
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-restricted-classes": "error",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/enforce-canonical": "error",
    "tailwindcss/enforce-shorthand": "warn",
    "tailwindcss/enforce-sort-order": "warn",
    "tailwindcss/prefer-theme-tokens": "warn",
    "tailwindcss/no-hardcoded-colors": "warn",
    "tailwindcss/consistent-variant-order": "warn",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": ["apps/desktop/src/**/*.ts", "apps/desktop/src/**/*.tsx"],
      "env": {
        "browser": true
      },
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Renderer must not import electron; use window.electronAPI via preload."
              },
              {
                "name": "react",
                "importNames": ["forwardRef"],
                "message": "React 19 uses ref as prop; use ref prop directly instead of forwardRef."
              },
              {
                "name": "slot-text/react",
                "message": "Use #app/shared/ui/SlotText instead of slot-text/react."
              }
            ],
            "patterns": [
              {
                "group": [
                  "electron/*",
                  "../electron",
                  "../electron/*",
                  "../../electron",
                  "../../electron/*"
                ],
                "message": "Renderer must not import electron main/preload code; use shared/ for IPC types."
              },
              {
                "group": [
                  "**/features/project-workbench/chrome/layout/**",
                  "**/features/project-workbench/chrome/titlebar/**",
                  "**/features/project-workbench/chrome/sidebar/**",
                  "**/features/project-workbench/chrome/statusbar/**"
                ],
                "message": "Import workbench chrome via #app/features/project-workbench/chrome (barrel), not internal subpaths."
              },
              {
                "group": [
                  "#app/features/project-workbench/worktree",
                  "#app/features/project-workbench/worktree/**",
                  "**/features/project-workbench/worktree",
                  "**/features/project-workbench/worktree/**"
                ],
                "message": "Renderer worktree/ domain was removed; use #app/features/project-workbench/session/changes-feed for feed/snapshot data."
              },
              {
                "group": [
                  "#app/features/project-workbench/state/molecules",
                  "**/features/project-workbench/state/molecules",
                  "**/features/project-workbench/state/**"
                ],
                "message": "Project scope lives in #app/features/project-workbench/session/project-scope; do not resurrect workbench/state/."
              },
              {
                "group": [
                  "#app/features/project-workbench/sidebar",
                  "#app/features/project-workbench/sidebar/**",
                  "**/features/project-workbench/sidebar",
                  "**/features/project-workbench/sidebar/**"
                ],
                "message": "Top-level sidebar/ business host was removed; primary views live in domain folders, chrome shell under #app/features/project-workbench/chrome."
              },
              {
                "group": [
                  "#app/features/project-workbench/statusbar",
                  "#app/features/project-workbench/statusbar/**",
                  "**/features/project-workbench/statusbar",
                  "**/features/project-workbench/statusbar/**"
                ],
                "message": "Top-level statusbar/ business host was removed; status items live in domains, assembly in composition/, chrome primitives via #app/features/project-workbench/chrome."
              },
              {
                "group": [
                  "#app/features/project-workbench/branch/branch-scopes",
                  "**/features/project-workbench/branch/branch-scopes"
                ],
                "message": "branch-scopes handle bus was removed; import scopes/handles from #app/features/project-workbench/session/*."
              }
            ]
          }
        ]
      }
    },
    {
